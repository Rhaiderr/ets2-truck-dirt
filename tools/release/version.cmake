# D7: the plugin's version, from git, at every build (cmake -P).
#
#   cmake -DBASE=0.1.0-alpha -DSRC=<repo> -DHEADER=<dir>/dirt_version.h -DTEXT=<dir>/version.txt -P version.cmake
#
# - a tag v<x.y.z...> on HEAD: that tag without the "v" (e.g. 0.1.0-alpha);
# - otherwise BASE-<short hash> (e.g. 0.1.0-alpha-bc0c6aa);
# - "-dirty" when tracked files differ from HEAD; "BASE-nogit" without git.
# HEADER gets `#define DIRT_VERSION "..."`, TEXT the bare version (tools/release/make_release.sh reads it).
# Both are written only when the version changes, so an unchanged version rebuilds nothing.
cmake_minimum_required(VERSION 3.20)

if(NOT BASE OR NOT SRC OR NOT HEADER)
    message(FATAL_ERROR "version.cmake: BASE, SRC and HEADER are required")
endif()

find_package(Git QUIET)
set(version "${BASE}-nogit")
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --short=7 HEAD
                    OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
    if(rc EQUAL 0 AND hash)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" describe --tags --exact-match --match "v[0-9]*" HEAD
                        OUTPUT_VARIABLE tag OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE tag_rc ERROR_QUIET)
        if(tag_rc EQUAL 0 AND tag)
            string(SUBSTRING "${tag}" 1 -1 version)
        else()
            set(version "${BASE}-${hash}")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" status --porcelain --untracked-files=no
                        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(changes)
            string(APPEND version "-dirty")
        endif()
    endif()
endif()

file(CONFIGURE OUTPUT "${HEADER}" CONTENT "// Generated by tools/release/version.cmake at build time; not in the repository.
#pragma once
#define DIRT_VERSION \"@version@\"
" @ONLY)
if(TEXT)
    file(CONFIGURE OUTPUT "${TEXT}" CONTENT "@version@\n" @ONLY)
endif()
