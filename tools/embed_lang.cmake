# Writes the bytes of every lang/<code>.txt into a C++ include for the DLL (src/lang_embed.cpp), so the texts
# need no file next to the DLL. Run by CMakeLists.txt at build time:
#   cmake -DLANG_DIR=<repo>/lang -DOUT=<build>/generated/lang_texts.inc -P tools/embed_lang.cmake
# Bytes as hex numbers: no string literal, so no limit of MSVC 2022 (C2026) and no escaping.
file(GLOB files "${LANG_DIR}/*.txt")
list(SORT files)
set(body "// Generated by tools/embed_lang.cmake from lang/*.txt: do not edit.\n")
set(table "")
foreach(f ${files})
    get_filename_component(code "${f}" NAME_WE)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR size "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    # 32 bytes a line
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" hex "${hex}")
    string(APPEND body "static const unsigned char kLang_${code}[] = {\n${hex}0x00};\n")
    string(APPEND table "    {\"${code}\", kLang_${code}, ${size}},\n")
endforeach()
string(APPEND body "static const EmbeddedLang kEmbeddedLangs[] = {\n${table}};\n")
file(WRITE "${OUT}" "${body}")
